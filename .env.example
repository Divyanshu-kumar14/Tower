# TOWER local/dev environment — endpoint/key NAMES only, zero secrets (T-06).
# Copy to .env (git-ignored) and fill values locally; T-11 moves these to
# Secret Manager. This file must NEVER contain values — only KEY= lines.

# Grafana Cloud OTLP base, e.g. https://otlp-gateway-prod-us-central-0.grafana.net/otlp
GRAFANA_CLOUD_OTLP_ENDPOINT=

# Grafana Cloud stack instance id (OTLP basic-auth username)
GRAFANA_CLOUD_INSTANCE_ID=

# Grafana Cloud access-policy token (OTLP basic-auth password ONLY — not valid
# for the stack HTTP API)
GRAFANA_CLOUD_API_KEY=

# Stack service-account token (Admin) for provision.py dashboard setup.
# Create in-stack: Administration → Service accounts → Add service account
# (Admin) → Add token. Falls back to GRAFANA_CLOUD_API_KEY if unset.
GRAFANA_STACK_API_TOKEN=

# Grafana Cloud stack URL for dashboard provisioning (provision.py --dry-run shows plan)
GRAFANA_CLOUD_URL=

# Google AI Studio key for the agent's Gemini parse (read at call time;
# missing = loud E17 failure, never silent)
GOOGLE_API_KEY=
